{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devbox",
  "version": "1.0.17",
  "identifier": "xyz.lecore.devbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "devbox 开发者工具箱",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOUU2RDY4RTUxMDRGRTMKUldUalR4RGxhRzJleS9tWmRKNmZIVWtEaWovL0N0Q0ZUN3IzSldBdHk5S1FvSE9pR0h6Z2hXbWMK",
      "endpoints": [
        "https://github.com/Jensen077/dev-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
